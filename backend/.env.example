# Copy to .env and fill in real values for local development.
# In production (Render), set these as environment variables in the dashboard instead.

# --- Core ---
ENVIRONMENT=development
API_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000

# --- Database (Postgres with the pgvector extension enabled) ---
# Local dev: a local Postgres instance. Production: your Supabase project's
# connection string (Project Settings -> Database -> Connection string).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/llmstxt

# --- Supabase Auth (verifies frontend-issued JWTs) ---
# Project Settings -> API for the URL/service role key.
SUPABASE_URL=https://your-project.supabase.co
# Legacy HS256 shared secret (Project Settings -> API -> JWT Settings). Optional: newer
# projects sign tokens asymmetrically (ES256/RS256) and are verified via the project's
# JWKS endpoint automatically, so this can be left blank for those.
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

# --- Redis / job queue ---
REDIS_URL=redis://localhost:6379/0

# --- OpenAI (optional in dev - summaries/quotes/search gracefully degrade without it) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Resend (optional in dev - welcome/congrats emails no-op without it) ---
RESEND_API_KEY=
EMAIL_FROM=llms.txt by Profound <onboarding@resend.dev>

# --- Crawler tuning ---
MAX_PAGES_PER_SITE=500
CRAWL_CONCURRENCY=8
CRAWL_TIMEOUT_SECONDS=15
CRAWL_JS_RENDER_LIMIT=50
CRAWL_JOB_TIMEOUT_SECONDS=1800
RECHECK_INTERVAL_HOURS=6
USER_AGENT=ProfoundLlmsTxtBot/1.0 (+https://tryprofound.com)

# --- Pricing (USD per 1K tokens), used by the cost tracker ---
PRICE_PER_1K_PROMPT_TOKENS=0.00015
PRICE_PER_1K_COMPLETION_TOKENS=0.0006
PRICE_PER_1K_EMBEDDING_TOKENS=0.00002
